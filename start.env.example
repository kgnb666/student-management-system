# 学生成绩管理系统本地启动配置
# 首次运行 start.bat 时会自动复制为 start.env，之后可直接修改 start.env。
# 注意：值中不要包含 ! 字符（批处理变量展开限制）。

# 数据库连接
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456

# 服务端口
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Tomcat 连接器协议：部分 Windows + JDK 组合下标准 NIO 会报
# "Unable to establish loopback connection"，保留 nio2 即可；
# 正常的 Linux 环境可改为 nio。
TOMCAT_PROTOCOL=nio2

# 可选：手动指定 JDK 目录（留空则自动查找 JAVA_HOME / PATH / 常见安装位置）
# JAVA_HOME=D:\tools\jdk\jdk-17.0.20.1+1

# 可选：手动指定 Maven 命令（verify.bat 使用；留空则要求 mvn 在 PATH 中）
# MVN_CMD=D:\tools\maven\bin\mvn.cmd
